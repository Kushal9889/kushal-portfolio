# Everything here is optional. With no keys the site still builds, still renders,
# and still answers from the corpus; each key upgrades one stage rather than
# enabling it. Copy to .env.local and fill in what you have.

# --- Language model -----------------------------------------------------------
# Leave unset to fall through the list below in order. Set explicitly to pin one.
# LLM_PROVIDER=openrouter | nvidia | openai

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Also used for build-time passage embeddings and query embeddings. Without it
# the index is lexical only and retrieval runs BM25 alone.
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Limits -------------------------------------------------------------------
# Budgeted in tokens rather than requests: one question can cost twenty times
# another, so request counts are a poor proxy for spend.
AGENT_DAILY_TOKEN_BUDGET=20000
AGENT_MAX_OUTPUT_TOKENS=400

# Azure OpenAI. Set LLM_PROVIDER=azure to make it primary.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_INSTANCE=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Model choice is a measured trade, not a default worth guessing at.
#   nvidia/nemotron-3-nano-30b-a3b   evals 16/16, TTFT p50 ~1.5s  (shipped)
#   meta/llama-3.1-8b-instruct       evals 15/16, TTFT p50 ~573ms
# The 8B is under 600ms and drops exact identifiers: it answered the LangChain
# question without naming CompositeBackend. Specificity is the point of these
# answers, so quality ships and speed is opt-in.
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
